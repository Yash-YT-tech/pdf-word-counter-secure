---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-neutral-200 dark:border-neutral-800 bg-white/50 dark:bg-neutral-950/50 backdrop-blur-sm transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
      <!-- Column 1: Brand & Privacy Commitment -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-neutral-900 dark:bg-white flex items-center justify-center text-white dark:text-neutral-900 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
              <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
              <path d="M10 13h4"></path>
              <path d="M10 17h4"></path>
            </svg>
          </div>
          <span class="font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 text-base">
            PDF Word Counter
          </span>
        </div>
        
        <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-md">
          A high-precision, client-side document inspection tool. Designed for legal teams, translators, researchers, and writers who require absolute confidentiality without sacrificing speed.
        </p>

        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-400 text-xs font-medium">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600 dark:text-emerald-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>Zero Server Uploads — 100% In-Browser Memory Processing</span>
        </div>
      </div>

      <!-- Column 2: Utility Tools -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-neutral-900 dark:text-neutral-100">
          Tools & Features
        </h3>
        <ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-400">
          <li><a href="/" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">PDF Word Counter</a></li>
          <li><a href="/pdf-page-counter" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">PDF Page Counter</a></li>
          <li><a href="/pdf-character-counter" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">PDF Character Counter</a></li>
          <li><a href="/pdf-reading-time" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">PDF Reading Time</a></li>
          <li><a href="/#why-private" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">Why Client-Side Privacy</a></li>
        </ul>
      </div>

      <!-- Column 3: Trust & Legal -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-neutral-900 dark:text-neutral-100">
          Trust & Legal
        </h3>
        <ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-400">
          <li><a href="/about" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">About Us</a></li>
          <li><a href="/privacy-policy" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">Terms of Service</a></li>
          <li><a href="/contact" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">Contact Support</a></li>
          <li>
            <a href="https://github.com/Yash-YT-tech/pdf-word-counter-secure" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
              <span>Source Code (GitHub)</span>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-neutral-200/60 dark:border-neutral-800/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500 dark:text-neutral-400">
      <p>© {currentYear} PDF Word Counter. Built for speed, privacy, and precision.</p>
      <div class="flex items-center gap-4">
        <span>Hosted securely on Cloudflare Edge</span>
        <span>•</span>
        <span>No Cookies Required</span>
      </div>
    </div>
  </div>
</footer>
