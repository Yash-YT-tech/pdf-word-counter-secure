---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact Support — Private PDF Word Counter"
  description="Need help or have feedback? Contact the PDF Word Counter support team."
>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-16 sm:py-24 space-y-8">
    <div class="space-y-3 text-center">
      <h1 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        Contact & Feedback
      </h1>
      <p class="text-sm text-neutral-600 dark:text-neutral-400">
        Have suggestions, encountered an unusual PDF file format, or need to report a bug? We'd love to hear from you.
      </p>
    </div>

    <div class="p-8 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/40 space-y-6">
      <div class="space-y-2">
        <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">Direct Support Email</h2>
        <p class="text-sm text-neutral-600 dark:text-neutral-400">
          Reach our team directly at:
        </p>
        <a
          href="mailto:support@pdfwordcounter.org"
          class="inline-block text-base font-medium text-blue-600 dark:text-blue-400 hover:underline"
        >
          support@pdfwordcounter.org
        </a>
      </div>

      <hr class="border-neutral-200 dark:border-neutral-800" />

      <div class="space-y-2">
        <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">Open Source & Issue Tracker</h2>
        <p class="text-sm text-neutral-600 dark:text-neutral-400">
          You can inspect our code, verify privacy claims, or submit an issue on our official GitHub repository:
        </p>
        <a
          href="https://github.com/Yash-YT-tech/pdf-word-counter-secure/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm font-medium text-neutral-900 dark:text-neutral-100 underline hover:opacity-80"
        >
          <span>GitHub Issue Tracker</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
      </div>
    </div>
  </div>
</Layout>
