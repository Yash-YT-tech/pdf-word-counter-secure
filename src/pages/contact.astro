---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact Support & Feedback — Private PDF Word Counter"
  description="Need help or have feedback? Contact the PDF Word Counter support team. We reply within 24-48 hours."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-24 space-y-12">
    <div class="space-y-3 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
        Get in Touch
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100">
        Contact & Feedback
      </h1>
      <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 max-w-lg mx-auto">
        Have suggestions, encountered an unusual PDF file format, or need custom document processing assistance? We are here to help.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Direct Email Card -->
      <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/40 space-y-4 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
        </div>
        <div class="space-y-1">
          <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">Support & Inquiries</h2>
          <p class="text-xs text-neutral-500 dark:text-neutral-400">
            Typical response time within 24–48 hours.
          </p>
        </div>
        <a
          href="mailto:support@pdfwordcounter.org"
          class="inline-block text-sm font-semibold text-blue-600 dark:text-blue-400 hover:underline"
        >
          support@pdfwordcounter.org
        </a>
      </div>

      <!-- GitHub Issues Card -->
      <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/40 space-y-4 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-neutral-100 dark:bg-neutral-800 text-neutral-900 dark:text-white flex items-center justify-center font-bold">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        </div>
        <div class="space-y-1">
          <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">Bug Reports & Feature Requests</h2>
          <p class="text-xs text-neutral-500 dark:text-neutral-400">
            File issues or request features directly on GitHub.
          </p>
        </div>
        <a
          href="https://github.com/Yash-YT-tech/pdf-word-counter-secure/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-neutral-900 dark:text-neutral-100 hover:opacity-80 underline"
        >
          <span>Open GitHub Issue</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
      </div>
    </div>

    <!-- Quick Help & FAQ box -->
    <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/30 text-center space-y-3">
      <h3 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">
        Looking for Quick Answers?
      </h3>
      <p class="text-xs text-neutral-600 dark:text-neutral-400 max-w-md mx-auto">
        Most questions about word calculation accuracy, password protection, and zero-upload security are answered on our homepage.
      </p>
      <div class="pt-1">
        <a href="/#faq" class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline">
          Browse Frequently Asked Questions →
        </a>
      </div>
    </div>
  </div>
</Layout>
