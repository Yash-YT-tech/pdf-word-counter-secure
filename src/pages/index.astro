---
import Layout from "../layouts/Layout.astro";
import PDFTool from "../components/PDFTool.astro";
import SEOContent from "../components/SEOContent.astro";
import FAQ from "../components/FAQ.astro";
---

<Layout
  title="PDF Word Counter — Free, Accurate & 100% Private Client-Side Word Count"
  description="Count words, pages, characters, and reading time in PDF documents directly in your browser. 100% private — your files never leave your device. Zero uploads, zero sign-up."
>
  <!-- Atmospheric Ambient Canvas -->
  <div class="fixed inset-0 -z-20 pointer-events-none overflow-hidden">
    <div class="absolute -top-[20%] left-1/2 -translate-x-1/2 w-[70rem] h-[35rem] rounded-full bg-gradient-to-b from-blue-500/10 via-emerald-500/10 to-transparent blur-3xl opacity-60 dark:opacity-30"></div>
    <div class="absolute top-[45%] -left-[10%] w-[45rem] h-[45rem] rounded-full bg-blue-500/5 blur-3xl opacity-50 dark:opacity-20"></div>
    <div class="absolute top-[65%] -right-[10%] w-[45rem] h-[45rem] rounded-full bg-emerald-500/5 blur-3xl opacity-50 dark:opacity-20"></div>
  </div>

  <!-- Attention: Cinematic Center Hero -->
  <section class="relative pt-20 pb-16 sm:pt-28 sm:pb-24 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
      <!-- Status Indicator -->
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full text-xs font-medium bg-neutral-900/[0.04] dark:bg-white/[0.06] border border-neutral-200/80 dark:border-neutral-800/80 text-neutral-800 dark:text-neutral-200 mb-8 backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="tracking-wide">Client-Side WASM Memory Pipeline</span>
        <span class="text-neutral-400 dark:text-neutral-600">•</span>
        <span class="text-neutral-500 dark:text-neutral-400">Zero Server Uploads</span>
      </div>

      <!-- Main Headline: Clamped to 2 lines max with ultra-wide container -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-[5rem] font-extrabold tracking-tight text-neutral-950 dark:text-white max-w-5xl mx-auto leading-[1.08]">
        Count Words and Pages with Absolute In-Browser Privacy
      </h1>

      <!-- Editorial Subtitle with Inline Typography Micro-Image -->
      <p class="mt-8 text-lg sm:text-xl text-neutral-600 dark:text-neutral-300 max-w-3xl mx-auto leading-relaxed font-normal">
        The confidential document inspector built for translators, attorneys, and academics. Inspect
        <span class="inline-block w-20 sm:w-24 h-6 sm:h-7 align-middle rounded-full mx-1.5 border border-emerald-500/40 overflow-hidden relative shadow-inner">
          <img
            src="https://picsum.photos/seed/documentcyber/300/150"
            class="w-full h-full object-cover grayscale contrast-125 opacity-85 mix-blend-luminosity"
            alt="Local memory security layer"
            loading="eager"
          />
        </span>
        unlimited PDFs directly in browser RAM with mathematical precision.
      </p>

      <!-- Dual High-Contrast CTAs -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="#tool"
          class="px-8 py-3.5 rounded-full text-sm font-semibold bg-neutral-950 text-white dark:bg-white dark:text-neutral-950 hover:opacity-90 transition-transform duration-200 hover:scale-[1.02] shadow-lg shadow-neutral-950/10 dark:shadow-white/5"
        >
          Inspect Document
        </a>
        <a
          href="#manifesto"
          class="px-8 py-3.5 rounded-full text-sm font-semibold bg-white/80 dark:bg-neutral-900/80 text-neutral-800 dark:text-neutral-200 border border-neutral-200/80 dark:border-neutral-800/80 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors duration-200 backdrop-blur-md"
        >
          Explore Privacy Proof
        </a>
      </div>
    </div>
  </section>

  <!-- Component Arsenal: Continuous Infinite Marquee -->
  <section class="py-8 border-y border-neutral-200/60 dark:border-neutral-800/60 bg-white/40 dark:bg-neutral-950/30 backdrop-blur-sm overflow-hidden select-none">
    <div class="marquee-track flex gap-12 whitespace-nowrap text-xs font-mono tracking-widest uppercase text-neutral-500 dark:text-neutral-400">
      <div class="marquee-content flex gap-12 items-center">
        <span>Zero Server Telemetry</span>
        <span class="text-emerald-500">•</span>
        <span>Client-Side Web Workers</span>
        <span class="text-emerald-500">•</span>
        <span>Flesch-Kincaid Readability</span>
        <span class="text-emerald-500">•</span>
        <span>Multi-Document Batch Analysis</span>
        <span class="text-emerald-500">•</span>
        <span>RFC 4180 CSV Breakdown</span>
        <span class="text-emerald-500">•</span>
        <span>Air-Gapped Operation</span>
        <span class="text-emerald-500">•</span>
        <span>No Account Required</span>
        <span class="text-emerald-500">•</span>
      </div>
      <div class="marquee-content flex gap-12 items-center" aria-hidden="true">
        <span>Zero Server Telemetry</span>
        <span class="text-emerald-500">•</span>
        <span>Client-Side Web Workers</span>
        <span class="text-emerald-500">•</span>
        <span>Flesch-Kincaid Readability</span>
        <span class="text-emerald-500">•</span>
        <span>Multi-Document Batch Analysis</span>
        <span class="text-emerald-500">•</span>
        <span>RFC 4180 CSV Breakdown</span>
        <span class="text-emerald-500">•</span>
        <span>Air-Gapped Operation</span>
        <span class="text-emerald-500">•</span>
        <span>No Account Required</span>
        <span class="text-emerald-500">•</span>
      </div>
    </div>
  </section>

  <!-- Interactive Core Application Section -->
  <section id="tool" class="py-24 sm:py-32 px-4 sm:px-6">
    <div id="tool-container" class="max-w-5xl mx-auto rounded-3xl border border-neutral-200/90 dark:border-neutral-800/90 bg-white/90 dark:bg-neutral-900/70 shadow-2xl shadow-neutral-950/5 dark:shadow-black/50 overflow-hidden backdrop-blur-2xl">
      <!-- Sandbox Navigation Header -->
      <div class="px-6 py-4 border-b border-neutral-200/80 dark:border-neutral-800/80 flex items-center justify-between bg-neutral-100/50 dark:bg-neutral-950/40">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-neutral-300 dark:bg-neutral-700"></div>
          <div class="w-3 h-3 rounded-full bg-neutral-300 dark:bg-neutral-700"></div>
          <div class="w-3 h-3 rounded-full bg-neutral-300 dark:bg-neutral-700"></div>
          <span class="ml-3 text-xs font-mono text-neutral-500 dark:text-neutral-400">client-worker://document-memory-sandbox</span>
        </div>
        <div class="flex items-center gap-2 text-xs font-mono text-emerald-600 dark:text-emerald-400">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>100% Offline Compatible</span>
        </div>
      </div>

      <!-- Core Interactive Workspace -->
      <div class="p-6 sm:p-10 lg:p-12 space-y-6">
        <PDFTool highlightMetric="words" />
      </div>
    </div>
  </section>

  <!-- Desire: GSAP Scrubbing Text Reveal Manifesto -->
  <section id="manifesto" class="py-28 sm:py-36 border-t border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-100/40 dark:bg-neutral-950/40">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-8">
      <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-emerald-600 dark:text-emerald-400">
        <span>Confidentiality Manifesto</span>
      </div>

      <p class="manifesto-text text-2xl sm:text-4xl md:text-5xl font-medium tracking-tight text-neutral-900 dark:text-neutral-100 leading-[1.3] text-balance">
        Traditional online utilities secretly transmit your confidential manuscripts, contracts, and financial statements to remote cloud servers. We engineered an isolated parser that executes strictly inside your local device RAM. Zero network transfers. Zero data leakage. Complete digital sovereignty.
      </p>

      <div class="pt-4 flex items-center justify-center gap-8 text-xs font-mono text-neutral-500 dark:text-neutral-400">
        <div>Client CPU: Active</div>
        <div>Remote Upload: 0 Bytes</div>
        <div>WASM Worker: Sandboxed</div>
      </div>
    </div>
  </section>

  <!-- Interest: Gapless Bento Grid (Mathematically Verified 12 Columns, Zero Dead Cells) -->
  <section id="why-private" class="py-28 sm:py-40 border-t border-neutral-200/80 dark:border-neutral-800/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-16">
      <div class="space-y-4 max-w-2xl">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-neutral-950 dark:text-white">
          Engineered for Extreme Confidentiality and Speed
        </h2>
        <p class="text-base sm:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Four fundamental engineering principles that separate client-side processing from vulnerable cloud converters.
        </p>
      </div>

      <!-- Bento Grid with grid-flow-dense -->
      <div id="bento-grid" class="grid grid-cols-1 md:grid-cols-12 gap-6 grid-flow-dense">
        <!-- Card 1: 8 Columns (Row 1 Part 1) -->
        <div class="bento-card group md:col-span-8 rounded-3xl border border-neutral-200/90 dark:border-neutral-800/90 bg-white/70 dark:bg-neutral-900/50 p-8 sm:p-10 flex flex-col justify-between overflow-hidden relative shadow-sm hover:border-neutral-400 dark:hover:border-neutral-600 transition-all duration-300">
          <div class="space-y-4 z-10 max-w-lg">
            <div class="w-10 h-10 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            </div>
            <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-950 dark:text-white">
              Air-Gapped In-Browser Execution
            </h3>
            <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
              When you load a document, our Web Worker pipeline parses the binary file structure in local volatile memory. You can disconnect your internet connection entirely and the tool will continue counting with identical precision.
            </p>
          </div>

          <div class="mt-8 pt-6 border-t border-neutral-200/60 dark:border-neutral-800/60 flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-neutral-500 dark:text-neutral-400">
            <span>Protocol: file-memory-buffer</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-semibold">NDA & HIPAA Compliant Architecture</span>
          </div>
        </div>

        <!-- Card 2: 4 Columns (Row 1 Part 2 -> Total Row 1 = 12 Cols) -->
        <div class="bento-card group md:col-span-4 rounded-3xl border border-neutral-200/90 dark:border-neutral-800/90 bg-white/70 dark:bg-neutral-900/50 p-8 sm:p-10 flex flex-col justify-between overflow-hidden relative shadow-sm hover:border-neutral-400 dark:hover:border-neutral-600 transition-all duration-300">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-2xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
            </div>
            <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-950 dark:text-white">
              Instantaneous CPU Throughput
            </h3>
            <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
              Zero network round-trips. Count a 300-page dissertation in less than 400 milliseconds using your computer's native multi-thread hardware.
            </p>
          </div>

          <div class="mt-8 pt-4 border-t border-neutral-200/60 dark:border-neutral-800/60 text-xs font-mono text-blue-600 dark:text-blue-400">
            Average Throughput: 1,200 Pages/sec
          </div>
        </div>

        <!-- Card 3: 4 Columns (Row 2 Part 1) -->
        <div class="bento-card group md:col-span-4 rounded-3xl border border-neutral-200/90 dark:border-neutral-800/90 bg-white/70 dark:bg-neutral-900/50 p-8 sm:p-10 flex flex-col justify-between overflow-hidden relative shadow-sm hover:border-neutral-400 dark:hover:border-neutral-600 transition-all duration-300">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="6" x2="12" y2="12"></line><line x1="12" y1="12" x2="16" y2="14"></line></svg>
            </div>
            <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-950 dark:text-white">
              Readability & Linguistic Density
            </h3>
            <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
              Calculates Flesch Reading Ease score, academic grade level, speaking duration, and words-per-page distribution in real time.
            </p>
          </div>

          <div class="mt-8 pt-4 border-t border-neutral-200/60 dark:border-neutral-800/60 text-xs font-mono text-amber-600 dark:text-amber-400">
            Algorithms: Flesch-Kincaid & WPM
          </div>
        </div>

        <!-- Card 4: 8 Columns (Row 2 Part 2 -> Total Row 2 = 12 Cols) -->
        <div class="bento-card group md:col-span-8 rounded-3xl border border-neutral-200/90 dark:border-neutral-800/90 bg-white/70 dark:bg-neutral-900/50 p-8 sm:p-10 flex flex-col justify-between overflow-hidden relative shadow-sm hover:border-neutral-400 dark:hover:border-neutral-600 transition-all duration-300">
          <div class="space-y-4 z-10 max-w-lg">
            <div class="w-10 h-10 rounded-2xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
            </div>
            <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-950 dark:text-white">
              Multi-Document Batch Ingestion
            </h3>
            <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
              Drop multiple PDF files simultaneously to calculate aggregated billing totals, combine reading schedules, and export an RFC 4180 audit spreadsheet ready for invoicing.
            </p>
          </div>

          <div class="mt-8 pt-6 border-t border-neutral-200/60 dark:border-neutral-800/60 flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-neutral-500 dark:text-neutral-400">
            <span>Export Format: RFC 4180 CSV</span>
            <span class="text-purple-600 dark:text-purple-400 font-semibold">Bulk Invoicing Ready</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Editorial Architectural Guide (SEO & Long-Form Authority) -->
  <section class="py-24 sm:py-32 border-t border-neutral-200/80 dark:border-neutral-800/80 bg-white/40 dark:bg-neutral-950/20">
    <SEOContent />
  </section>

  <!-- FAQ Accordion with Structured JSON-LD Schema -->
  <section id="faq" class="py-24 sm:py-32 border-t border-neutral-200/80 dark:border-neutral-800/80">
    <FAQ />
  </section>

  <!-- Action: High-Contrast Closing Anchor -->
  <section class="py-28 sm:py-36 border-t border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-950 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-20 pointer-events-none bg-[radial-gradient(circle_at_center,rgba(16,185,129,0.3)_0,transparent_70%)]"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-8 relative z-10">
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight">
        Inspect Your Documents Without Compromising Privacy
      </h2>
      <p class="text-base sm:text-lg text-neutral-400 max-w-2xl mx-auto leading-relaxed">
        Free, private, and instant. No email, no registration, and zero cloud uploads. Built for professionals who value confidentiality.
      </p>
      <div class="pt-4">
        <a
          href="#tool"
          class="inline-block px-10 py-4 rounded-full text-base font-semibold bg-white text-neutral-950 hover:bg-neutral-100 transition-transform duration-200 hover:scale-105 shadow-xl shadow-white/10"
        >
          Count Your PDF Now
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .marquee-track {
    display: flex;
    width: 200%;
    animation: marquee 35s linear infinite;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Split words in the manifesto text for sequential GSAP scrubbing
  const manifestoEl = document.querySelector(".manifesto-text");
  if (manifestoEl && manifestoEl.textContent) {
    const rawText = manifestoEl.textContent.trim();
    const words = rawText.split(/\s+/);
    manifestoEl.innerHTML = words
      .map((word) => `<span class="scrub-word inline-block transition-opacity opacity-20 mr-1.5">${word}</span>`)
      .join("");

    gsap.to(".scrub-word", {
      opacity: 1,
      stagger: 0.05,
      ease: "none",
      scrollTrigger: {
        trigger: "#manifesto",
        start: "top 75%",
        end: "bottom 60%",
        scrub: true,
      },
    });
  }

  // Tool container scale reveal
  const toolContainer = document.getElementById("tool-container");
  if (toolContainer) {
    gsap.fromTo(
      toolContainer,
      { scale: 0.97, opacity: 0.8 },
      {
        scale: 1,
        opacity: 1,
        duration: 0.8,
        ease: "power2.out",
        scrollTrigger: {
          trigger: toolContainer,
          start: "top 85%",
        },
      }
    );
  }

  // Bento card stagger reveal
  const bentoCards = document.querySelectorAll(".bento-card");
  if (bentoCards.length > 0) {
    gsap.fromTo(
      bentoCards,
      { y: 35, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.7,
        stagger: 0.12,
        ease: "power3.out",
        scrollTrigger: {
          trigger: "#bento-grid",
          start: "top 80%",
        },
      }
    );
  }
</script>
