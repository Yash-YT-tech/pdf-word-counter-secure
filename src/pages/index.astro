---
import Layout from "../layouts/Layout.astro";
import DropZone from "../components/DropZone.astro";
import StatsDisplay from "../components/StatsDisplay.astro";
import PageBreakdown from "../components/PageBreakdown.astro";
---

<Layout
  title="PDF Word Counter — Free, Accurate & 100% Private Client-Side Word Count"
  description="Count words, pages, characters, and reading time in PDF documents directly in your browser. 100% private — your files never leave your device. Zero uploads, zero sign-up."
>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-8 sm:pt-16 sm:pb-12 overflow-hidden">
    <!-- Subtle Background Glow -->
    <div class="absolute inset-0 -z-10 flex items-center justify-center opacity-40 dark:opacity-20 pointer-events-none">
      <div class="w-[32rem] h-[32rem] rounded-full bg-gradient-to-tr from-blue-500/20 via-emerald-500/20 to-transparent blur-3xl"></div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center space-y-4">
      <!-- Eyebrow Pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Zero Server Uploads • 100% Client-Side Privacy</span>
      </div>

      <!-- Main Heading -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 max-w-3xl mx-auto leading-[1.15]">
        Count Words, Pages & Characters in Any PDF
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto leading-relaxed">
        The private, in-browser document inspector for translators, students, and legal professionals. Your PDF is parsed in your browser memory and never uploaded to any server.
      </p>
    </div>
  </section>

  <!-- Interactive Tool Section -->
  <section id="tool" class="max-w-4xl mx-auto px-4 sm:px-6 pb-16">
    <div class="rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 shadow-xl shadow-neutral-900/5 dark:shadow-black/40 overflow-hidden backdrop-blur-xl">
      <!-- Tool Header Bar -->
      <div class="px-6 py-4 border-b border-neutral-200 dark:border-neutral-800 flex items-center justify-between bg-neutral-50/50 dark:bg-neutral-900/40">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-red-400/80"></div>
          <div class="w-3 h-3 rounded-full bg-amber-400/80"></div>
          <div class="w-3 h-3 rounded-full bg-emerald-400/80"></div>
          <span class="ml-2 text-xs font-mono text-neutral-500 dark:text-neutral-400">browser-memory-sandbox://pdf-inspector</span>
        </div>
        <div class="flex items-center gap-2 text-xs font-medium text-emerald-600 dark:text-emerald-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>Offline Ready</span>
        </div>
      </div>

      <!-- Core Interactive Zone -->
      <div class="p-6 sm:p-10 space-y-6">
        <DropZone />
        <StatsDisplay />
        <PageBreakdown />
      </div>
    </div>
  </section>

  <!-- Value Matrix / Why Private Section -->
  <section id="why-private" class="py-16 border-t border-neutral-200 dark:border-neutral-800 bg-white/40 dark:bg-neutral-950/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-12">
      <div class="text-center space-y-3 max-w-2xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
          Why Client-Side Privacy Matters
        </h2>
        <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Most online word counters require uploading your entire file to cloud servers. Here is how we protect your confidentiality:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Traditional Cloud Tools -->
        <div class="p-6 rounded-2xl border border-red-200/80 dark:border-red-950/60 bg-red-50/20 dark:bg-red-950/10 space-y-4">
          <div class="flex items-center gap-2 text-red-600 dark:text-red-400 font-semibold text-sm">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
            <span>Traditional Online PDF Tools</span>
          </div>
          <ul class="space-y-2.5 text-sm text-neutral-600 dark:text-neutral-400">
            <li class="flex items-start gap-2">
              <span class="text-red-500 font-bold">✕</span>
              <span>Uploads confidential documents to unknown remote cloud servers</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-red-500 font-bold">✕</span>
              <span>Violates NDAs, legal confidentiality agreements, and data sovereignty</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-red-500 font-bold">✕</span>
              <span>Sluggish upload queues for large, multi-megabyte files</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-red-500 font-bold">✕</span>
              <span>Freemium traps with forced registration and paid subscriptions</span>
            </li>
          </ul>
        </div>

        <!-- Our Tool -->
        <div class="p-6 rounded-2xl border border-emerald-200/80 dark:border-emerald-950/60 bg-emerald-50/20 dark:bg-emerald-950/10 space-y-4">
          <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-semibold text-sm">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="16 10 10 16 7 13"></polyline></svg>
            <span>Our In-Browser Client-Side Engine</span>
          </div>
          <ul class="space-y-2.5 text-sm text-neutral-700 dark:text-neutral-300 font-medium">
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>100% Client-side: Your file is parsed directly in browser RAM</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Zero server transfers: Completely compliant with strict corporate NDAs</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Instantaneous processing: Sub-second metric calculations on your CPU</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>100% Free forever: No logins, no cookies, no accounts, no limits</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section id="how-it-works" class="py-16 border-t border-neutral-200 dark:border-neutral-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-12">
      <div class="text-center space-y-3 max-w-2xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
          How It Works in 3 Simple Steps
        </h2>
        <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400">
          Effortlessly inspect any document in seconds with zero configuration.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/40 space-y-3">
          <div class="w-8 h-8 rounded-full bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 font-bold text-sm flex items-center justify-center">
            1
          </div>
          <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">Select or Drop Your PDF</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Drag any PDF document into the browser drop zone or click browse to choose from your local drive.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/40 space-y-3">
          <div class="w-8 h-8 rounded-full bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 font-bold text-sm flex items-center justify-center">
            2
          </div>
          <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">Instant Local Processing</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            The browser reads the document text stream via background Web Workers, extracting characters, words, and pages.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/40 space-y-3">
          <div class="w-8 h-8 rounded-full bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 font-bold text-sm flex items-center justify-center">
            3
          </div>
          <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">Review & Export Metrics</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            View total counts, reading and speaking times, page-by-page tables, and export breakdowns to CSV for billing.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { analyzePDF, formatBytes, exportToCSV, type PDFAnalysisResult } from "../scripts/pdf-processor";

  let currentResult: PDFAnalysisResult | null = null;

  // DOM Elements
  const dropzone = document.getElementById("dropzone");
  const fileInput = document.getElementById("pdf-file-input") as HTMLInputElement | null;
  const processingState = document.getElementById("processing-state");
  const processingTitle = document.getElementById("processing-title");
  const processingSubtitle = document.getElementById("processing-subtitle");
  const processingProgressBar = document.getElementById("processing-progress-bar");
  const errorState = document.getElementById("error-state");
  const errorMessage = document.getElementById("error-message");
  const errorDismissBtn = document.getElementById("error-dismiss-btn");

  const statsContainer = document.getElementById("stats-container");
  const fileNameDisplay = document.getElementById("file-name-display");
  const fileSizeDisplay = document.getElementById("file-size-display");
  const statWords = document.getElementById("stat-words");
  const statPages = document.getElementById("stat-pages");
  const statCharsSpaces = document.getElementById("stat-chars-spaces");
  const statCharsNoSpaces = document.getElementById("stat-chars-nospaces");
  const statReadingTime = document.getElementById("stat-reading-time");
  const statSpeakingTime = document.getElementById("stat-speaking-time");
  const scannedPdfWarning = document.getElementById("scanned-pdf-warning");

  const breakdownContainer = document.getElementById("breakdown-container");
  const breakdownPageCountBadge = document.getElementById("breakdown-page-count-badge");
  const pageBreakdownTbody = document.getElementById("page-breakdown-tbody");
  const pageSearchInput = document.getElementById("page-search-input") as HTMLInputElement | null;

  const copySummaryBtn = document.getElementById("copy-summary-btn");
  const copyIcon = document.getElementById("copy-icon");
  const copiedIcon = document.getElementById("copied-icon");
  const copyBtnText = document.getElementById("copy-btn-text");
  const exportCsvBtn = document.getElementById("export-csv-btn");
  const resetBtn = document.getElementById("reset-btn");

  function showError(msg: string) {
    if (errorMessage && errorState) {
      errorMessage.textContent = msg;
      errorState.classList.remove("hidden");
    }
    if (processingState) processingState.classList.add("hidden");
    if (dropzone) dropzone.classList.remove("hidden");
  }

  function hideError() {
    if (errorState) errorState.classList.add("hidden");
  }

  async function handleFile(file: File) {
    if (!file) return;

    if (!file.name.toLowerCase().endsWith(".pdf") && file.type !== "application/pdf") {
      showError("Please select a valid PDF document (.pdf).");
      return;
    }

    hideError();

    // Show processing state
    if (dropzone) dropzone.classList.add("hidden");
    if (statsContainer) statsContainer.classList.add("hidden");
    if (breakdownContainer) breakdownContainer.classList.add("hidden");
    if (processingState) processingState.classList.remove("hidden");
    if (processingProgressBar) processingProgressBar.style.width = "5%";

    try {
      const result = await analyzePDF(file, (current, total) => {
        if (processingTitle) {
          processingTitle.textContent = `Analyzing page ${current} of ${total}...`;
        }
        if (processingSubtitle) {
          processingSubtitle.textContent = `${Math.round((current / total) * 100)}% complete`;
        }
        if (processingProgressBar) {
          processingProgressBar.style.width = `${Math.max(5, Math.round((current / total) * 100))}%`;
        }
      });

      currentResult = result;

      // Hide processing state
      if (processingState) processingState.classList.add("hidden");

      // Populate Stats
      if (fileNameDisplay) fileNameDisplay.textContent = result.fileName;
      if (fileSizeDisplay) fileSizeDisplay.textContent = formatBytes(result.fileSizeBytes);
      if (statWords) statWords.textContent = result.totalWords.toLocaleString();
      if (statPages) statPages.textContent = result.totalPages.toLocaleString();
      if (statCharsSpaces) statCharsSpaces.textContent = result.totalCharacters.toLocaleString();
      if (statCharsNoSpaces) statCharsNoSpaces.textContent = result.totalCharactersNoSpaces.toLocaleString();
      if (statReadingTime) statReadingTime.textContent = `${result.estimatedReadingTimeMinutes} min`;
      if (statSpeakingTime) statSpeakingTime.textContent = `${result.estimatedSpeakingTimeMinutes} min`;

      // Scanned Document Alert
      if (scannedPdfWarning) {
        if (result.isScannedOrImageOnly) {
          scannedPdfWarning.classList.remove("hidden");
        } else {
          scannedPdfWarning.classList.add("hidden");
        }
      }

      // Populate Page Breakdown Table
      if (breakdownPageCountBadge) {
        breakdownPageCountBadge.textContent = `${result.totalPages} ${result.totalPages === 1 ? "page" : "pages"}`;
      }

      if (pageBreakdownTbody) {
        pageBreakdownTbody.innerHTML = result.pages
          .map(
            (p) => `
          <tr class="hover:bg-neutral-50 dark:hover:bg-neutral-800/50 transition-colors" data-page="${p.pageNumber}">
            <td class="py-2.5 px-4 font-bold text-neutral-900 dark:text-neutral-100">Page ${p.pageNumber}</td>
            <td class="py-2.5 px-4">${p.wordCount.toLocaleString()}</td>
            <td class="py-2.5 px-4">${p.characterCount.toLocaleString()}</td>
            <td class="py-2.5 px-4">${p.characterCountNoSpaces.toLocaleString()}</td>
            <td class="py-2.5 px-4 text-right">
              ${
                p.hasText
                  ? '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">Digital Text</span>'
                  : '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400">No Text / Image</span>'
              }
            </td>
          </tr>
        `
          )
          .join("");
      }

      // Show Stats and Breakdown Containers
      if (statsContainer) statsContainer.classList.remove("hidden");
      if (breakdownContainer) breakdownContainer.classList.remove("hidden");

      // Smooth scroll to results
      statsContainer?.scrollIntoView({ behavior: "smooth", block: "nearest" });
    } catch (err: any) {
      console.error("PDF Parsing Error:", err);
      if (err?.name === "PasswordException") {
        showError("This PDF is password protected. Please unlock the file and try again.");
      } else {
        showError(`Failed to process PDF: ${err?.message || "Corrupted or unreadable format"}`);
      }
    }
  }

  // Click dropzone to browse
  dropzone?.addEventListener("click", () => {
    fileInput?.click();
  });

  // Input file change
  fileInput?.addEventListener("change", (e) => {
    const target = e.target as HTMLInputElement;
    if (target.files && target.files.length > 0) {
      handleFile(target.files[0]);
    }
  });

  // Drag and Drop Events
  ["dragenter", "dragover"].forEach((eventName) => {
    dropzone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      e.stopPropagation();
      dropzone.classList.add("border-neutral-900", "dark:border-white", "bg-neutral-100/80", "dark:bg-neutral-800/80");
    });
  });

  ["dragleave", "drop"].forEach((eventName) => {
    dropzone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      e.stopPropagation();
      dropzone.classList.remove("border-neutral-900", "dark:border-white", "bg-neutral-100/80", "dark:bg-neutral-800/80");
    });
  });

  dropzone?.addEventListener("drop", (e) => {
    const dt = e.dataTransfer;
    if (dt && dt.files && dt.files.length > 0) {
      handleFile(dt.files[0]);
    }
  });

  // Error dismiss button
  errorDismissBtn?.addEventListener("click", () => {
    hideError();
  });

  // Reset Button (Analyze Another PDF)
  resetBtn?.addEventListener("click", () => {
    currentResult = null;
    if (fileInput) fileInput.value = "";
    if (statsContainer) statsContainer.classList.add("hidden");
    if (breakdownContainer) breakdownContainer.classList.add("hidden");
    if (dropzone) dropzone.classList.remove("hidden");
    hideError();
  });

  // Copy Summary Button
  copySummaryBtn?.addEventListener("click", async () => {
    if (!currentResult) return;

    const summary = [
      `PDF Document Analysis: ${currentResult.fileName}`,
      `----------------------------------------`,
      `• Total Words: ${currentResult.totalWords.toLocaleString()}`,
      `• Total Pages: ${currentResult.totalPages.toLocaleString()}`,
      `• Characters (with spaces): ${currentResult.totalCharacters.toLocaleString()}`,
      `• Characters (no spaces): ${currentResult.totalCharactersNoSpaces.toLocaleString()}`,
      `• Est. Reading Time: ${currentResult.estimatedReadingTimeMinutes} min (at 225 wpm)`,
      `• Est. Speaking Time: ${currentResult.estimatedSpeakingTimeMinutes} min (at 130 wpm)`,
      `• Document Type: ${currentResult.isScannedOrImageOnly ? "Scanned/Image Document (OCR Recommended)" : "Digital Text Document"}`,
      `----------------------------------------`,
      `100% Client-Side Privacy: Verified zero server uploads.`,
      `https://pdfwordcounter.org`,
    ].join("\n");

    try {
      await navigator.clipboard.writeText(summary);
      if (copyIcon && copiedIcon && copyBtnText) {
        copyIcon.classList.add("hidden");
        copiedIcon.classList.remove("hidden");
        copyBtnText.textContent = "Copied!";
        setTimeout(() => {
          copyIcon.classList.remove("hidden");
          copiedIcon.classList.add("hidden");
          copyBtnText.textContent = "Copy Summary";
        }, 2000);
      }
    } catch (e) {
      console.error("Clipboard copy error:", e);
    }
  });

  // Export CSV Button
  exportCsvBtn?.addEventListener("click", () => {
    if (!currentResult) return;

    const csvContent = exportToCSV(currentResult);
    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    const cleanFileName = currentResult.fileName.replace(/\.pdf$/i, "");
    a.href = url;
    a.download = `${cleanFileName}-word-count-report.csv`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  // Page Search / Filter
  pageSearchInput?.addEventListener("input", (e) => {
    const query = (e.target as HTMLInputElement).value.trim().toLowerCase();
    const rows = pageBreakdownTbody?.querySelectorAll("tr");
    if (!rows) return;

    rows.forEach((row) => {
      const pageNum = row.getAttribute("data-page");
      if (!query || (pageNum && pageNum.includes(query))) {
        row.classList.remove("hidden");
      } else {
        row.classList.add("hidden");
      }
    });
  });
</script>
