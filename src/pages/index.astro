---
import Layout from "../layouts/Layout.astro";
import PDFTool from "../components/PDFTool.astro";
import SEOContent from "../components/SEOContent.astro";
import FAQ from "../components/FAQ.astro";
---

<Layout
  title="PDF Word Counter — Free, Accurate & 100% Private Client-Side Word Count"
  description="Count words, pages, characters, and reading time in PDF documents directly in your browser. 100% private — your files never leave your device. Zero uploads, zero sign-up."
>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-8 sm:pt-16 sm:pb-12 overflow-hidden">
    <!-- Subtle Background Glow -->
    <div class="absolute inset-0 -z-10 flex items-center justify-center opacity-40 dark:opacity-20 pointer-events-none">
      <div class="w-[32rem] h-[32rem] rounded-full bg-gradient-to-tr from-blue-500/20 via-emerald-500/20 to-transparent blur-3xl"></div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center space-y-4">
      <!-- Eyebrow Pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Zero Server Uploads • 100% Client-Side Privacy</span>
      </div>

      <!-- Main Heading -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 max-w-3xl mx-auto leading-[1.15]">
        Count Words, Pages & Characters in Any PDF
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto leading-relaxed">
        The private, in-browser document inspector for translators, students, and legal professionals. Your PDF is parsed in your browser memory and never uploaded to any server.
      </p>
    </div>
  </section>

  <!-- Interactive Tool Section -->
  <section id="tool" class="max-w-4xl mx-auto px-4 sm:px-6 pb-16">
    <div class="rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 shadow-xl shadow-neutral-900/5 dark:shadow-black/40 overflow-hidden backdrop-blur-xl">
      <!-- Tool Header Bar -->
      <div class="px-6 py-4 border-b border-neutral-200 dark:border-neutral-800 flex items-center justify-between bg-neutral-50/50 dark:bg-neutral-900/40">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-red-400/80"></div>
          <div class="w-3 h-3 rounded-full bg-amber-400/80"></div>
          <div class="w-3 h-3 rounded-full bg-emerald-400/80"></div>
          <span class="ml-2 text-xs font-mono text-neutral-500 dark:text-neutral-400">browser-memory-sandbox://pdf-inspector</span>
        </div>
        <div class="flex items-center gap-2 text-xs font-medium text-emerald-600 dark:text-emerald-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>Offline Ready</span>
        </div>
      </div>

      <!-- Core Interactive Zone -->
      <div class="p-6 sm:p-10 space-y-6">
        <PDFTool highlightMetric="words" />
      </div>
    </div>
  </section>

  <!-- Value Matrix / Why Private Section -->
  <section id="why-private" class="py-16 border-t border-neutral-200 dark:border-neutral-800 bg-white/40 dark:bg-neutral-950/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-12">
      <div class="text-center space-y-3 max-w-2xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
          Why Client-Side Privacy Matters
        </h2>
        <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Most online word counters require uploading your entire file to cloud servers. Here is how we protect your confidentiality:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Traditional Cloud Tools -->
        <div class="p-6 rounded-2xl border border-red-200/80 dark:border-red-950/60 bg-red-50/20 dark:bg-red-950/10 space-y-4">
          <div class="flex items-center gap-2 text-red-600 dark:text-red-400 font-semibold text-sm">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
            <span>Traditional Online PDF Tools</span>
          </div>
          <ul class="space-y-2.5 text-sm text-neutral-600 dark:text-neutral-400">
            <li class="flex items-start gap-2">
              <span class="text-red-500 font-bold">✕</span>
              <span>Uploads confidential documents to unknown remote cloud servers</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-red-500 font-bold">✕</span>
              <span>Violates NDAs, legal confidentiality agreements, and data sovereignty</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-red-500 font-bold">✕</span>
              <span>Sluggish upload queues for large, multi-megabyte files</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-red-500 font-bold">✕</span>
              <span>Freemium traps with forced registration and paid subscriptions</span>
            </li>
          </ul>
        </div>

        <!-- Our Tool -->
        <div class="p-6 rounded-2xl border border-emerald-200/80 dark:border-emerald-950/60 bg-emerald-50/20 dark:bg-emerald-950/10 space-y-4">
          <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-semibold text-sm">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="16 10 10 16 7 13"></polyline></svg>
            <span>Our In-Browser Client-Side Engine</span>
          </div>
          <ul class="space-y-2.5 text-sm text-neutral-700 dark:text-neutral-300 font-medium">
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>100% Client-side: Your file is parsed directly in browser RAM</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Zero server transfers: Completely compliant with strict corporate NDAs</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Instantaneous processing: Sub-second metric calculations on your CPU</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>100% Free forever: No logins, no cookies, no accounts, no limits</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section id="how-it-works" class="py-16 border-t border-neutral-200 dark:border-neutral-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-12">
      <div class="text-center space-y-3 max-w-2xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
          How It Works in 3 Simple Steps
        </h2>
        <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400">
          Effortlessly inspect any document in seconds with zero configuration.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/40 space-y-3">
          <div class="w-8 h-8 rounded-full bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 font-bold text-sm flex items-center justify-center">
            1
          </div>
          <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">Select or Drop Your PDF</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Drag any PDF document into the browser drop zone or click browse to choose from your local drive.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/40 space-y-3">
          <div class="w-8 h-8 rounded-full bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 font-bold text-sm flex items-center justify-center">
            2
          </div>
          <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">Instant Local Processing</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            The browser reads the document text stream via background Web Workers, extracting characters, words, and pages.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/40 space-y-3">
          <div class="w-8 h-8 rounded-full bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 font-bold text-sm flex items-center justify-center">
            3
          </div>
          <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">Review & Export Metrics</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            View total counts, reading and speaking times, page-by-page tables, and export breakdowns to CSV for billing.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- In-Depth Editorial Guide (1000+ Words for SEO & AdSense) -->
  <SEOContent />

  <!-- FAQ Accordion with JSON-LD FAQPage Schema -->
  <FAQ />
</Layout>

